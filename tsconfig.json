{
    "compilerOptions": {
      "target": "ES2021",
      "module": "commonjs",
      "lib": [
        "es2021"
      ],
      "outDir": "./dist",
      "rootDir": "./src",
      "resolveJsonModule": true,
      "strict": true,
      "esModuleInterop": true,
      "noImplicitAny": true,
      "skipLibCheck": true
    },
    "include": [
      "src/"
    ],
    "exclude": [
      "**/*.spec.ts"
    ]
  }